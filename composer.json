{
    "name": "alsendo/alsendo-one-sdk",
    "description": "AlsendoOne SDK — official PHP client for Apaczka API v2",
    "type": "library",
    "license": "MIT",
    "keywords": ["apaczka", "alsendo", "shipping", "api", "sdk", "courier"],
    "homepage": "https://github.com/Alsendo/AlsendoOneSDK",
    "authors": [
        {
            "name": "Alsendo",
            "homepage": "https://alsendo.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Alsendo/AlsendoOneSDK/issues",
        "source": "https://github.com/Alsendo/AlsendoOneSDK"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Recommended HTTP client implementation (^7.0)",
        "guzzlehttp/psr7": "PSR-7/PSR-17 message implementation (^2.0)"
    },
    "autoload": {
        "psr-4": {
            "AlsendoOne\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlsendoOne\\SDK\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
